            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Region_Config</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_SLA_Due</name>
        <label>Set SLA Due</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SLA_Due__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SLA_Due_Formula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Config_Found</name>
        <label>Config Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Region_Config</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_SLA_Due</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>RegionFinal</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.Region__c})), TEXT({!Get_Order.Region__c}), TEXT({!$Record.Region__c}))</expression>
    </formulas>
    <formulas>
        <name>SLA_Due_Formula</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + ({!Get_Region_Config.SLA_Hours__c} / 24)</expression>
    </formulas>
    <interviewLabel>Case BeforeSave Defaults {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case BeforeSave Defaults</label>
    <processMetadataValues>
        <name>BuilderType</name>
