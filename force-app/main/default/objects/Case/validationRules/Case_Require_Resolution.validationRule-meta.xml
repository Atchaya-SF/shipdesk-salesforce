<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Require_Resolution</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status, &quot;Closed&quot;), ISBLANK( Resolution__c ))</errorConditionFormula>
    <errorMessage>Enter RESOLUTION before closing the case</errorMessage>
</ValidationRule>
