<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Return_Requires_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.DeveloperName =&quot; Return_Request&quot;, ISBLANK( Order__c ) )</errorConditionFormula>
    <errorMessage>A return order must be linked with an order</errorMessage>
</ValidationRule>
